# apps/api
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mytaman?schema=public"
PORT=4000

# LLM providers — all optional here. Any left blank can instead be added/managed later from the
# admin "Model Router Settings" tab (no redeploy needed). Setting one here "locks" that
# provider's key to this value — it always takes precedence over a key entered in the UI. If more
# than one provider ends up configured (via env var or the UI), MODEL_PROVIDER_ORDER controls the
# initial priority (defaults to "anthropic,gemini,openai"); the first is tried first, and the
# router falls back to the next on a rate limit / outage / auth failure. Order/enabled state can
# also be changed at runtime from the "Model Router Settings" tab.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# MODEL_PROVIDER_ORDER="anthropic,gemini,openai"

# Encrypts provider API keys saved via the "Model Router Settings" UI at rest (AES-256-GCM).
# Optional but recommended for production — without it, a key derived from DATABASE_URL is used
# instead, which is weaker if an attacker can also read DATABASE_URL.
CREDENTIAL_ENCRYPTION_KEY=""

# apps/web
# NOTE: this is baked into the browser bundle at build time (docker compose build).
# For local dev, localhost is fine. For a VM deploy, set this to the VM's public
# IP/domain (e.g. http://20.1.2.3:4000) *before* building, or the browser on your
# laptop won't be able to reach the API. See docs/AZURE_DEPLOYMENT.md.
NEXT_PUBLIC_API_URL="http://localhost:4000"
