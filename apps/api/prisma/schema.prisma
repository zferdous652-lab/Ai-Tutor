generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARENT
  STUDENT
}

enum TutorPackStatus {
  PROCESSING
  DRAFT
  FAILED
}

enum PackTier {
  BASIC
  PREMIUM
  XPOINTS
}

model Family {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  users       User[]
  enrollments Enrollment[]
}

model User {
  id            String          @id @default(cuid())
  family        Family          @relation(fields: [familyId], references: [id])
  familyId      String
  name          String
  role          Role
  language      String          @default("en") // "en" | "ms"
  createdAt     DateTime        @default(now())
  chatMessages  ChatMessage[]
  quizAttempts  QuizAttempt[]
  xpointsLedger XpointsLedger[]
  enrollments   Enrollment[]
}

// A course an admin builds and publishes, e.g. "KSSM Form 1 Sejarah". Not owned by any
// family — families get access via Enrollment. Not visible to students until publishedAt
// is set. `tier` decides which features are available: BASIC is pre-generated content only
// (summary/quiz/flashcards/notes), PREMIUM/XPOINTS additionally unlock live AI chat.
model TutorPack {
  id          String          @id @default(cuid())
  title       String
  subject     String
  standard    String // e.g. "KSSM"
  language    String          @default("en")
  tier        PackTier        @default(BASIC)
  status      TutorPackStatus @default(PROCESSING)
  rawText     String?
  // [{ page: number, description: string }] — diagrams/maps/photos found by rendering PDF
  // pages to images and captioning them with a vision model. Not attributed to a specific
  // chapter (see docs/MVP_PLAN.md); null if the admin didn't request visual analysis.
  visualNotes Json?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  chapters    Chapter[]
  enrollments Enrollment[]
}

model Chapter {
  id           String        @id @default(cuid())
  tutorPack    TutorPack     @relation(fields: [tutorPackId], references: [id])
  tutorPackId  String
  order        Int
  title        String
  content      String
  summary      String?
  chatMessages ChatMessage[]
  quiz         Quiz?

  @@unique([tutorPackId, order])
}

// A parent giving one of their children access to a published TutorPack.
model Enrollment {
  id          String    @id @default(cuid())
  family      Family    @relation(fields: [familyId], references: [id])
  familyId    String
  student     User      @relation(fields: [studentId], references: [id])
  studentId   String
  tutorPack   TutorPack @relation(fields: [tutorPackId], references: [id])
  tutorPackId String
  createdAt   DateTime  @default(now())

  @@unique([studentId, tutorPackId])
}

model Quiz {
  id        String        @id @default(cuid())
  chapter   Chapter       @relation(fields: [chapterId], references: [id])
  chapterId String        @unique
  questions Json // [{ question, options: string[], correctIndex, topic }]
  createdAt DateTime      @default(now())
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id         String   @id @default(cuid())
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  quizId     String
  student    User     @relation(fields: [studentId], references: [id])
  studentId  String
  score      Float // 0..1
  weakTopics Json // string[] of topics answered incorrectly
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  chapterId String
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  role      String // "student" | "tutor"
  content   String
  createdAt DateTime @default(now())
}

model XpointsLedger {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  delta     Int // negative = spend, positive = grant
  reason    String
  createdAt DateTime @default(now())
}

// Singleton row (id is always "singleton") letting an admin change the LLM fallback order and
// enable/disable individual providers at runtime, without editing env vars or redeploying.
// Only covers providers that actually have an API key configured via env vars — this never
// stores secrets.
model ModelRouterSetting {
  id                String   @id @default("singleton")
  // Ordered provider names, e.g. ["anthropic", "gemini", "openai"]. Providers with no API key
  // configured are ignored even if listed here.
  providerOrder     String[]
  // Provider names an admin has manually turned off, even though an API key is configured.
  disabledProviders String[]
  updatedAt         DateTime @updatedAt
}

// API key entered via the admin "Model Router Settings" UI, encrypted at rest (AES-256-GCM,
// see lib/crypto.ts). Only used when the matching env var (e.g. ANTHROPIC_API_KEY) is NOT set —
// an env var always takes precedence, so a key set here can be safely overridden by deploy
// config without conflicting.
model ProviderCredential {
  name      String   @id // "anthropic" | "gemini" | "openai"
  apiKeyEnc String
  updatedAt DateTime @updatedAt
}
